<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">
  <test thread-count="1" name="Test">
    <parameter name="browser" value="chrome"/>
    <parameter name="urlfb" value="https://www.facebook.com"/>

    <packages>
      <package name="test">
        <classes>
          <class name="test.Assertions_Test">
            <methods>
              <exclude name=".*"/> <!-- exclude all methods of this class -->
            </methods>
          </class>
        </classes>
      </package>
    </packages>
  </test>
</suite>
